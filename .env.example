# Copy to .env (or export) for docker compose / docker run
#
# UID/GID MUST match the external Unraid user that owns the shared volumes.
PI_UID=1000
PI_GID=100
PI_USER_NAME=pi

# Node major line (bump deliberately)
NODE_MAJOR_VERSION=26

# npm tag / exact version of @earendil-works/pi-coding-agent
PI_NPM_VERSION=latest

# Path on the host mounted at /home/pi/workspace inside the container
HOST_WORKSPACE=/path/to/your/workspace

# Obsidian vault: path on the host mounted at /home/pi/obsidian
OBSIDIAN_VAULT_HOST_DIR=/path/to/obsidian

# Image tag
PI_TAG=latest

# ---------------------------------------------------------------------------
# Hindsight (long-term memory, shared bank with Hermes)
#   Point at your Hindsight server (Docker DNS or LAN URL) — no /v1 suffix,
#   the official CLI appends paths itself.
#   HINDSIGHT_API_KEY must equal the server's HINDSIGHT_TENANT_API_KEY.
#   HINDSIGHT_BANK_ID: the one shared bank (default: agents).
# ---------------------------------------------------------------------------
HINDSIGHT_API_URL=http://your-hindsight-host:8888
HINDSIGHT_API_KEY=
***

# ---------------------------------------------------------------------------
# MCP bridge (mcp mode — the persistent daemon Hermes talks to)
#   REQUIRED: PI_MCP_API_KEY — the bridge refuses to start without it.
#   Generate one:  openssl rand -hex 32
#   Port is published to the host so Hermes (on the LAN) can reach it.
#   Keep it internal: don't route through traefik publicly, or at least keep
#   the API key strong.
# ---------------------------------------------------------------------------
PI_MCP_API_KEY=
PI_MCP_PORT=3103
# Per-task hard timeout (seconds) for a single pi run.
PI_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# ACP adapter (acp mode — WebSocket server, bearer-key auth)
#   REQUIRED — refuses to start open: PI_ACP_API_KEY. The ACP server exits
#   without binding any socket when it is missing.
#   Generate one:  openssl rand -hex 32
#   Reached as ws://pi-sandbox-acp:3123 on the Docker (traefik) network —
#   no host port is published.
#   LAN route: the host's Traefik exposes it at PI_ACP_DOMAIN. Set that to
#   a name under your Cloudflare-managed domain and add the DNS A record;
#   the "production" certresolver issues the Let's Encrypt cert
#   automatically (DNS challenge — no ports opened). The "secured"
#   middleware chain (RFC1918 IP whitelist + security headers) keeps the
#   endpoint reachable only from LAN clients. The Mac's acp-proxy then
#   uses wsUrl = wss://<PI_ACP_DOMAIN>.
#   PI_ACP_ENTRYPOINTS / PI_ACP_CERTRESOLVER / PI_ACP_MIDDLEWARES default
#   to the Unraid host's names (https / production / secured@file).
#   NOTE the @file suffix: the middlewares live in Traefik's FILE provider
#   (conf/middlewares.yml), and docker-label routers resolve unqualified
#   names against the docker provider ("middleware X@docker does not
#   exist"). Keep the suffix when overriding.
# ---------------------------------------------------------------------------
PI_ACP_API_KEY=
PI_ACP_PORT=3123
PI_ACP_DOMAIN=pi.example.lan
PI_ACP_ENTRYPOINTS=https
PI_ACP_CERTRESOLVER=production
PI_ACP_MIDDLEWARES=secured@file

# --- Provider / model (all optional — defaults baked into image) ---
# Provider key (used in models.json "providers" object)
PI_LLM_PROVIDER_NAME=vllm

# Provider endpoint (your OpenAI-compatible server, e.g. vLLM)
PI_LLM_BASE_URL=http://your-llm-host:8000/v1
PI_LLM_API=openai-completions
PI_LLM_API_KEY=***

# Model
PI_LLM_MODEL_ID=your-org/your-model
PI_LLM_MODEL_NAME=your-org/your-model (example)
PI_LLM_REASONING=true
PI_LLM_INPUT=text
PI_LLM_CONTEXT_WINDOW=262144
PI_LLM_MAX_TOKENS=32768

# ---------------------------------------------------------------------------
# GitHub (for pushing this repo / build-from-repo workflows)
#   - GITHUB_TOKEN: a Personal Access Token (PAT) with repo scope.
#     Used for authenticated git push/pull and gh CLI.
#   - GITHUB_USER / GITHUB_EMAIL: commit identity (or set git config --global).
#   - GITHUB_REPO: full repo name (user/repo).
#   - The push step builds an authenticated remote URL:
#       https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPO}.git
#     (token embedded in URL — keep .env private)
#
#   Token scopes needed:
#     Public repo:  public_repo  (or "repo" for private repos)
#     Minimal:      repo, or a Fine-Grained token with Contents: Read+Write
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_USER=fcogomez
GITHUB_EMAIL=
GITHUB_REPO=fcogomez/pi_sandbox
