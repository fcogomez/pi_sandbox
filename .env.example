# Copy to .env (or export) for docker compose / docker run
#
# UID/GID MUST match the external Unraid user that owns the shared volumes.
PI_UID=1000
PI_GID=100
PI_USER_NAME=pi

# Node major line (bump deliberately)
NODE_MAJOR_VERSION=26

# npm tag / exact version of @earendil-works/pi-coding-agent
PI_NPM_VERSION=latest

# Path on the host mounted at /home/pi/workspace inside the container
HOST_WORKSPACE=/mnt/user/appdata/pi/workspace

# Image tag
PI_TAG=latest

# --- Provider / model (all optional — defaults baked into image) ---
# Provider key (used in models.json "providers" object)
PI_LLM_PROVIDER_NAME=vllm

# Provider endpoint
PI_LLM_BASE_URL=http://vLLM_Qwen3.8_27B_BF16:8000/v1
PI_LLM_API=openai-completions
PI_LLM_API_KEY=nerdtastic

# Model
PI_LLM_MODEL_ID=Qwen/Qwen3.8-27B
PI_LLM_MODEL_NAME=Qwen/Qwen3.8-27B (vLLM)
PI_LLM_REASONING=true
PI_LLM_INPUT=text
PI_LLM_CONTEXT_WINDOW=262144
PI_LLM_MAX_TOKENS=32768

# ---------------------------------------------------------------------------
# GitHub (for pushing this repo / build-from-repo workflows)
#   - GITHUB_TOKEN: a Personal Access Token (PAT) with repo scope.
#     Used for authenticated git push/pull and gh CLI.
#   - GITHUB_USER / GITHUB_EMAIL: commit identity (or set git config --global).
#   - GITHUB_REPO: full repo name (user/repo).
#   - The push step builds an authenticated remote URL:
#       https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPO}.git
#     (token embedded in URL — keep .env private)
#
#   Token scopes needed:
#     Public repo:  public_repo  (or "repo" for private repos)
#     Minimal:      repo, or a Fine-Grained token with Contents: Read+Write
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_USER=fcogomez
GITHUB_EMAIL=
GITHUB_REPO=fcogomez/pi_sandbox
